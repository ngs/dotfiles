<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ssh-add-a</string>
    <!-- The modern spelling of `ssh-add -A`: add the identities whose
         passphrases are already in the keychain. (`--apple-use-keychain` is the
         replacement for -K — it *stores* passphrases when adding a key — and is
         not what this job wants: at login there is no one to type one.) -->
    <key>ProgramArguments</key>
    <array>
        <string>ssh-add</string>
        <string>--apple-load-keychain</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>

